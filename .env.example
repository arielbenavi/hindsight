GEMINI_API_KEY=
BOT_TOKEN=
SAVEFEED_API_URL=http://localhost:8000

# Optional: path to a Netscape-format cookies.txt with logged-in cookies for
# instagram.com AND x.com. When set + present, yt-dlp and gallery-dl skip
# --cookies-from-browser and read this file directly — no macOS keychain
# prompts on every capture. See README for export instructions.
IG_COOKIES_FILE=

# Optional: X/Twitter API credentials for bookmark sweep.
# Sign up at developer.x.com, create a project + app, enable OAuth 2.0
# (confidential client, PKCE), add callback http://localhost:8000/auth/twitter/callback.
# Pay-per-use: bookmarks cost $0.001/read.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional: IG username for saved-posts sweep via Instaloader.
# After setting this, authenticate once: instaloader --login <username>
IG_USERNAME=
